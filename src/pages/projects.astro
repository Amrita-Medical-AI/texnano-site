---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Research' };
---

<Layout metadata={metadata}>
  <main class="min-h-[40vh] flex flex-col items-center justify-center px-4 text-center">
    <p class="text-gray-700 dark:text-gray-300 mb-4">Redirecting to Research…</p>
    <a href="/#research" class="text-primary font-medium underline">Go to Research section</a>
  </main>
  <script is:inline>
    window.location.replace('/#research');
  </script>
</Layout>
