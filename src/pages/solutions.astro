---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AI Medical Solutions | Tex Nano',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Our Solutions"
    title="Advanced AI Medical Tools"
    subtitle="Discover our comprehensive suite of AI-powered medical solutions designed to revolutionize healthcare delivery and improve patient outcomes."
    image={{
      src: '~/assets/images/solutions-hero.jpg',
      alt: 'Tex Nano Medical Solutions',
    }}
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="AI Diagnostic Suite"
    subtitle="Our flagship AI-powered diagnostic tools provide unprecedented accuracy and efficiency in medical diagnosis."
    items={[
      {
        title: 'NanoScan AI',
        description: 'Advanced medical imaging analysis using deep learning for radiology and pathology.',
        icon: 'tabler:scan',
      },
      {
        title: 'MedLLM',
        description: 'Large Language Model specifically trained on medical literature and clinical data.',
        icon: 'tabler:brain',
      },
      {
        title: 'Clinical Assistant',
        description: 'AI-powered clinical decision support system for healthcare professionals.',
        icon: 'tabler:stethoscope',
      },
    ]}
  />

  <!-- Content Widget **************** -->
  <Content
    isReversed
    title="Research & Development Platform"
    subtitle="Accelerate medical research and drug discovery with our AI-powered R&D tools."
    items={[
      {
        title: 'Drug Discovery AI',
        description: 'Accelerate drug development with AI-powered molecular modeling and prediction.',
      },
      {
        title: 'Clinical Trial Optimizer',
        description: 'Streamline clinical trials with intelligent patient matching and data analysis.',
      },
      {
        title: 'Research Database',
        description: 'Access and analyze vast medical research data with our AI-powered search platform.',
      },
    ]}
    image={{
      src: '~/assets/images/research-platform.jpg',
      alt: 'Research Platform',
    }}
  />

  <!-- Content Widget **************** -->
  <Content
    title="Patient Care Solutions"
    subtitle="Enhance patient care with real-time monitoring and predictive analytics."
    items={[
      {
        title: 'Patient Monitor AI',
        description: 'Real-time patient monitoring with predictive health alerts.',
      },
      {
        title: 'Treatment Optimizer',
        description: 'AI-driven treatment recommendations based on patient data and outcomes.',
      },
      {
        title: 'Care Coordinator',
        description: 'Automated care coordination and patient engagement platform.',
      },
    ]}
    image={{
      src: '~/assets/images/patient-care.jpg',
      alt: 'Patient Care Solutions',
    }}
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="Integration & Support"
    subtitle="Seamless integration with your existing healthcare systems and comprehensive support."
    items={[
      {
        title: 'EMR Integration',
        description: 'Easy integration with major Electronic Medical Record systems.',
        icon: 'tabler:database',
      },
      {
        title: '24/7 Support',
        description: 'Round-the-clock technical support and clinical assistance.',
        icon: 'tabler:headset',
      },
      {
        title: 'Custom Solutions',
        description: 'Tailored AI solutions for specific healthcare needs.',
        icon: 'tabler:settings',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Schedule a Demo',
        href: '/contact',
      },
      {
        text: 'Learn More',
        href: '/about',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Transform Your Healthcare Practice?
    </Fragment>
    <Fragment slot="subtitle">
      Contact us to learn how Tex Nano's AI solutions can benefit your institution.
    </Fragment>
  </CallToAction>
</Layout> 