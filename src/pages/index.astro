---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: 'TexNano — Medical AI Research',
  ignoreTitleTemplate: true,
  description:
    'TexNano develops real-time AI tools for medical diagnosis: pancreatic cancer, liver disease, and heart conditions. Research at Amrita Institute of Medical Sciences, Kochi.',
  openGraph: {
    type: 'website',
  },
};

// Team data (moved from team page)
const topTeam = [
  { name: 'Dr. Priya Nair', designation: 'Project Lead', image: '~/assets/images/dr-priya-nair.png' },
  { name: 'Gilad Gressel', designation: 'Research Director', image: '~/assets/images/gilad.jpg' },
];
const team = [
  { name: 'Abhijit Ramesh', designation: 'Lead Engineer', image: '~/assets/images/abhijit.png' },
  { name: 'Gautham Krishnan', designation: 'AI Engineer', image: '~/assets/images/gautham.jpeg' },
  { name: 'Anshuman Swain', designation: 'AI Engineer', image: '~/assets/images/anshuman.jpeg' },
  { name: 'Anushka Kaimal', designation: 'AI Engineer', image: '~/assets/images/anushka.jpeg' },
  { name: 'Aniketh ', designation: 'AI Engineer', image: '~/assets/images/aniketh.png' },
  { name: 'Srisharanyan', designation: 'AI Engineer', image: '~/assets/images/sharan.png' },
];
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: 'Our Research', href: '#research' },
      { text: 'Contact', href: 'mailto:anshumanswain@am.amrita.edu' },
    ]}
  >
    <Fragment slot="title">
      <span class="text-primary">TexNano</span><span class="text-gray-900 dark:text-gray-100">
        — real-time AI for diagnosis</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-gray-900 dark:text-gray-300"
        >We develop real-time AI tools to assist doctors in diagnosing pancreatic cancer, liver disease, and heart
        conditions. Our focus is on providing clinicians with reliable, instant analysis to speed up patient care.</span
      >
    </Fragment>

    <Fragment slot="content">
      <p class="text-sm text-gray-900 dark:text-gray-400 mt-5 font-medium">
        Amrita Institute of Medical Sciences, Kochi & Amrita Vishwa Vidyapeetham, Amritapuri · Kerala
      </p>
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="What we do"
    title="From imaging to decisions"
    subtitle="We work across the pipeline: better models, clearer outputs, and deployment that fits the clinic."
    items={[
      {
        title: 'Diagnostic AI',
        description:
          'ML models that support accurate, interpretable diagnosis — so clinicians can trust and act on the output.',
        icon: 'tabler:brain',
      },
      {
        title: 'Medical language models',
        description: 'Models trained on medical literature to assist with clinical reasoning and documentation.',
        icon: 'tabler:dna',
      },
      {
        title: 'Medical imaging',
        description: 'Image analysis for radiology and pathology — segmentation, classification, and quality at scale.',
        icon: 'tabler:scan',
      },
      {
        title: 'Clinical integration',
        description: 'Deployment designed for existing workflows and healthcare systems.',
        icon: 'tabler:network',
      },
    ]}
  />

  <!-- Research section -->
  <WidgetWrapper id="research" containerClass="max-w-4xl mx-auto px-4 md:px-6 pt-8 pb-8 md:pt-10 md:pb-10 lg:pt-12 lg:pb-12">
    <Headline
      tagline="Research"
      title="Our research work"
      subtitle="AI for medical imaging and diagnosis — from pancreatic cancer and fatty liver to congenital heart disease and inflammatory bowel disease."
      classes={{ container: 'max-w-2xl mx-auto text-center mb-5' }}
    />

    <Content
      id="eusml"
      classes={{ container: 'py-0 pt-4 md:pt-6 pb-6 md:pb-8' }}
      tagline="Project"
      title="EUS-ML"
      subtitle="Pancreatic cancer detection using Endoscopic Ultrasound (EUS)."
      titleAlign="left"
      items={[
        {
          title: 'Classification',
          description: '<strong>94.12%</strong> sensitivity, <strong>86.30%</strong> specificity, <strong>98.44%</strong> NPV (Negative Predictive Value).',
        },
        {
          title: 'Segmentation',
          description: '<strong>70%</strong> DICE score for pancreas segmentation from EUS video.',
        },
        {
          title: 'Real-time inference',
          description: 'EUSML-Inference App runs at <strong>~21.28 FPS</strong> for use during live procedures.',
        },
      ]}
      image={{ src: '~/assets/images/eusml.png', alt: 'EUS-ML — add project image' }}
    >
      <Fragment slot="content">
        <p class="mb-4">
          Developed tools for pancreatic cancer detection using Endoscopic Ultrasound (EUS). The project involved <strong
            >Segmentation</strong
          > (finding the pancreas and tumor) and <strong>Classification</strong> (determining if a patient has cancer). The
          team utilized a dataset comprising 400+ annotated patient videos.
        </p>
        <p class="text-sm font-medium text-gray-700 mt-4">Key results</p>
      </Fragment>
    </Content>

    <Content
      id="fatty-liver"
      isReversed
      classes={{ container: 'py-4 md:py-6' }}
      tagline="Project"
      title="Fatty-Liver Diagnosis"
      subtitle="Differentiating fatty liver from non-fatty liver using AI and widely available ultrasound."
      titleAlign="left"
      items={[
        {
          title: 'Impact',
          description:
            'The project aims to achieve accuracy similar to Fibroscan while drastically reducing the cost of testing from ₹3,000–₹10,000 to approximately ₹600–₹800 per test, expanding access to millions.',
        },
      ]}
      image={{ src: '~/assets/images/liver.png', alt: 'Fatty-Liver Diagnosis — add project image' }}
    >
      <Fragment slot="content">
        <p class="mb-4">
          Focused on differentiating fatty liver from non-fatty liver by teaching AI to learn <strong
            >Liver Steatosis</strong
          > and <strong>Fibrosis</strong> scores from normal ultrasound images. The objective is to replicate the expensive
          "Gold Standard" Fibroscan results using widely available, cheaper ultrasound machines.
        </p>
      </Fragment>
    </Content>

    <Content
      id="vr-heart"
      classes={{ container: 'py-4 md:py-6' }}
      tagline="Project"
      title="VR-Heart"
      subtitle="3D heart visualization from CT for Congenital Heart Disease (CHD) and VR surgical consultations."
      titleAlign="left"
      items={[
        {
          title: 'Whole heart (bloodpool)',
          description: '<strong>0.90</strong> DICE score — full heart segmentation from CT.',
        },
        {
          title: 'Chambers & vessels',
          description: '<strong>0.78</strong> DICE score — chamber and vessel segmentation.',
        },
        {
          title: 'VR & 3D Lab',
          description: 'Surgeons use VR consultations on 3D heart models to plan and rehearse complex CHD surgeries.',
        },
      ]}
      image={{ src: '~/assets/images/vr-heart.png', alt: 'VR-Heart — add project image' }}
    >
      <Fragment slot="content">
        <p class="mb-4">
          Addressed the challenge surgeons face in visualizing 2D scans as 3D structures for Congenital Heart Disease
          (CHD). The team used AI to automate the segmentation of the heart from CT scans (reducing manual time from 2–3
          hours), allowing the heart models to be loaded into Virtual Reality for surgical consultations.
        </p>
        <p class="text-sm font-medium text-gray-700 mt-4">Key results</p>
      </Fragment>
    </Content>

    <Content
      id="ulcerative-colitis"
      isReversed
      classes={{ container: 'py-4 md:py-6' }}
      tagline="Project"
      title="Ulcerative Colitis Diagnosis"
      subtitle="AI to assess severity of IBD / Ulcerative Colitis and reduce reliance on biopsies."
      titleAlign="left"
      items={[]}
      image={{ src: '~/assets/images/ulcerative-colitis.png', alt: 'Ulcerative Colitis Diagnosis — add project image' }}
    >
      <Fragment slot="content">
        <p class="mb-4">
          Investigating the use of AI to diagnose the severity of Inflammatory Bowel Disease (IBD) / Ulcerative Colitis
          to make biopsies non-required. The goal is to predict histopathology Nancy score using AI, making the process
          less invasive, cheaper, and faster than the traditional workflow.
        </p>
      </Fragment>
    </Content>
  </WidgetWrapper>

  <!-- Team section -->
  <section id="team" class="relative scroll-mt-[72px] border-t border-gray-200 dark:border-slate-700">
    <WidgetWrapper id="team-heading" containerClass="max-w-4xl mx-auto px-4 md:px-6 py-5 md:py-6">
      <Headline
        tagline="Team"
        title="Our team"
        subtitle="Researchers and clinicians at Amrita Institute of Medical Sciences, Kochi & Amrita Vishwa Vidyapeetham, Amritapuri."
        classes={{ container: 'max-w-2xl mx-auto text-center' }}
      />
    </WidgetWrapper>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pb-5 md:pb-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 justify-items-center">
        {
          topTeam.map((person) => (
            <div class="flex flex-col items-center text-center w-full max-w-[180px] md:max-w-[200px]">
              <div class="w-36 h-36 sm:w-36 sm:h-36 aspect-square rounded-lg overflow-hidden bg-gray-100 dark:bg-slate-700 mb-2 flex-shrink-0">
                <Image
                  src={person.image}
                  alt={person.name}
                  width={160} 
                  height={160}
                  widths={[160, 160]}
                  sizes="(max-width: 640px) 160px, 176px"
                  class="w-full h-full object-cover"
                />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{person.name}</h3>
              <p class="text-primary text-sm mt-0.5">{person.designation}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-5 md:py-6 border-t border-gray-200 dark:border-slate-700">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-5 md:gap-6 justify-items-center">
        {
          team.map((person) => (
            <div class="flex flex-col items-center text-center w-full max-w-[140px] sm:max-w-[160px]">
              <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-lg overflow-hidden bg-gray-100 dark:bg-slate-700 mb-2 flex-shrink-0">
                <Image
                  src={person.image}
                  alt={person.name}
                  width={224}
                  height={224}
                  widths={[192, 224]}
                  sizes="(max-width: 640px) 96px, 112px"
                  class="w-full h-full object-cover"
                />
              </div>
              <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">{person.name}</h3>
              <p class="text-gray-800 dark:text-muted text-xs mt-0.5">{person.designation}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    id="contact-cta"
    actions={[{ variant: 'primary', text: 'Get in touch', href: 'mailto:anshumanswain@am.amrita.edu' }]}
  >
    <Fragment slot="title"> Work with us </Fragment>
    <Fragment slot="subtitle">
      Partnerships, funding, or joint research — we're interested. Reach out to discuss how we can collaborate.
    </Fragment>
  </CallToAction>
</Layout>
