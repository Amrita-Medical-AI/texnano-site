---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Tex Nano - Advanced AI Medical Technology & Research',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Learn More',
        href: '#features',
      },
      { text: 'Contact Us', href: '/contact' },
    ]}
    image={{ src: '~/assets/images/medical-ai.jpg', alt: 'Tex Nano AI Medical Technology' }}
  >
    <Fragment slot="title">
      Revolutionizing Healthcare with <span class="text-accent dark:text-white highlight">AI Technology</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Tex Nano</span> combines cutting-edge artificial intelligence with advanced medical research
      </span>
      to develop next-generation diagnostic tools and treatment solutions. Our AI-powered platforms are transforming healthcare
      delivery and improving patient outcomes.
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Our Solutions"
    title="Advancing Healthcare Through AI"
    subtitle="Discover how our AI-powered solutions are revolutionizing medical diagnosis, research, and treatment."
    items={[
      {
        title: 'AI Diagnostic Tools',
        description:
          'Advanced machine learning algorithms for rapid and accurate medical diagnosis across multiple specialties.',
        icon: 'tabler:brain',
      },
      {
        title: 'Medical LLMs',
        description:
          'Specialized large language models trained on medical literature to assist healthcare professionals in decision-making.',
        icon: 'tabler:dna',
      },
      {
        title: 'Research Platform',
        description:
          'AI-powered research tools for drug discovery, clinical trials, and medical data analysis.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Patient Care Analytics',
        description:
          'Real-time monitoring and predictive analytics for improved patient care and treatment outcomes.',
        icon: 'tabler:heartbeat',
      },
      {
        title: 'Medical Imaging AI',
        description:
          'State-of-the-art image recognition and analysis for radiology, pathology, and medical imaging.',
        icon: 'tabler:scan',
      },
      {
        title: 'Healthcare Integration',
        description:
          'Seamless integration with existing healthcare systems and workflows for enhanced efficiency.',
        icon: 'tabler:network',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Active Hospitals', amount: '500+' },
      { title: 'Patients Analyzed', amount: '1M+' },
      { title: 'Accuracy Rate', amount: '99.9%' },
      { title: 'Research Papers', amount: '150+' },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="AI Innovation"
    title="Next-Generation Medical AI"
    items={[
      {
        title: 'Deep Learning Models',
        description:
          'Our proprietary deep learning models are trained on vast medical datasets for superior diagnostic accuracy.',
      },
      {
        title: 'Real-time Analysis',
        description:
          'Process and analyze medical data in real-time for immediate insights and decision support.',
      },
      {
        title: 'Continuous Learning',
        description:
          'Our AI systems continuously learn and improve from new medical data and research findings.',
      },
    ]}
    image={{
      src: '~/assets/images/medical-research.jpg',
      alt: 'Medical AI Research',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Transforming Healthcare</h3>
      Leveraging advanced AI technology to revolutionize medical diagnosis and treatment
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">
      Transform Your Healthcare Practice with AI
    </Fragment>

    <Fragment slot="subtitle">
      Join leading healthcare institutions in adopting Tex Nano's advanced AI solutions.
    </Fragment>
  </CallToAction>
</Layout>
