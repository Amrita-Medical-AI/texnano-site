---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About us"
    title="Medical AI research team"
    subtitle="We are a research team focused on developing AI methods and tools that can support healthcare professionals and improve patient care."
  />

  <Steps2
    title="Our approach"
    subtitle="We combine rigorous methods with close collaboration with clinicians and institutions."
    items={[
      {
        title: 'Evidence-based',
        description:
          'Our work is grounded in medical evidence and validated on appropriate datasets. We publish our methods and results to support reproducibility.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Interdisciplinary',
        description:
          'We work across AI, medicine, and health informatics. Collaboration with clinicians and domain experts is central to our research.',
        icon: 'tabler:users',
      },
      {
        title: 'Responsible innovation',
        description:
          'We care about safety, fairness, and transparency. Our goal is technology that supports—not replaces—clinical judgment.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <Features2
    title="What we value"
    subtitle="These principles guide how we conduct research and build tools."
    columns={3}
    items={[
      {
        title: 'Rigor',
        description: 'Sound methodology, clear evaluation, and honest reporting of limitations.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Openness',
        description: 'We share code, data where possible, and findings to advance the field.',
        icon: 'tabler:world',
      },
      {
        title: 'Impact',
        description: 'We aim for work that can meaningfully support healthcare delivery and research.',
        icon: 'tabler:heartbeat',
      },
    ]}
  />
</Layout>
