---
import '@fontsource-variable/source-sans-3';
---

<style is:inline>
  :root,
  html {
    color-scheme: light;
  }
  :root {
    --aw-font-sans: 'Source Sans 3 Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Source Sans 3 Variable', ui-serif, Georgia, serif;
    --aw-font-heading: 'Source Sans 3 Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 16px;

    /* Medical / research: teal, minimal, scientific */
    --aw-color-primary: rgb(13, 148, 136);
    --aw-color-secondary: rgb(15, 118, 110);
    --aw-color-accent: rgb(20, 184, 166);

    /* Dark text for clear readability on light background */
    --aw-color-text-heading: rgb(15, 23, 42);
    --aw-color-text-default: rgb(15, 23, 42);
    --aw-color-text-muted: rgb(51, 65, 85);
    --aw-color-text-page: rgb(15, 23, 42);
    --aw-color-bg-page: rgb(255, 255, 255);

    --aw-color-bg-page-dark: rgb(15, 23, 42);

    ::selection {
      background-color: rgb(13, 148, 136);
      color: white;
    }
  }

  .dark {
    --aw-font-sans: 'Source Sans 3 Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Source Sans 3 Variable', ui-serif, Georgia, serif;
    --aw-font-heading: 'Source Sans 3 Variable', ui-sans-serif, system-ui, sans-serif;

    --aw-color-primary: rgb(45, 212, 191);
    --aw-color-secondary: rgb(20, 184, 166);
    --aw-color-accent: rgb(94, 234, 212);

    --aw-color-text-heading: rgb(248, 250, 252);
    --aw-color-text-default: rgb(226, 232, 240);
    --aw-color-text-muted: rgb(148, 163, 184);
    --aw-color-bg-page: rgb(15, 23, 42);

    ::selection {
      background-color: rgb(45, 212, 191);
      color: rgb(15, 23, 42);
    }
  }
</style>
