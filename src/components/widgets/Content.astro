---
import type { Content as Props } from '~/types';
import Headline from '../ui/Headline.astro';
import WidgetWrapper from '../ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import ItemGrid from '../ui/ItemGrid.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction,
  items = [],
  columns,
  image = await Astro.slots.render('image'),
  isReversed = false,
  isAfterContent = false,
  titleAlign = 'center',

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const headlineContainerClass = titleAlign === 'left' ? 'max-w-2xl text-left' : 'max-w-xl sm:mx-auto lg:max-w-2xl';
const headlineSubtitleClass =
  titleAlign === 'left'
    ? 'max-w-2xl text-left text-base text-gray-800 dark:text-muted'
    : 'max-w-2xl mx-auto sm:text-center text-base text-gray-800 dark:text-muted';
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''} ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: headlineContainerClass,
      title: 'text-2xl md:text-3xl font-semibold tracking-tight mb-3 font-heading text-gray-900 dark:text-default',
      subtitle: headlineSubtitleClass,
    }}
  />
  <div class="mx-auto max-w-4xl p-4 md:px-6">
    <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-10`}>
      <div class="md:basis-1/2 self-center">
        {content && <div class="mb-8 text-base text-gray-800 dark:text-muted leading-relaxed" set:html={content} />}

        {
          callToAction && (
            <div class="mt-[-40px] mb-8 text-primary">
              <Button variant="link" {...callToAction} />
            </div>
          )
        }

        {
          items.length > 0 && (
            <ItemGrid
              items={items}
              columns={columns}
              defaultIcon="tabler:check"
              classes={{
                container: 'gap-y-3 md:gap-y-4',
                panel: 'max-w-none',
                title: 'text-base font-semibold text-default ml-2 rtl:ml-0 rtl:mr-2',
                description: 'text-base text-gray-800 dark:text-muted mt-1.5 ml-2 rtl:ml-0 rtl:mr-2 leading-relaxed',
                icon: 'flex h-7 w-7 items-center justify-center rounded-full bg-primary text-white p-1',
                action: 'text-base font-medium text-default ml-2 rtl:ml-0 rtl:mr-2',
              }}
            />
          )
        }
      </div>
      <div aria-hidden="true" class="mt-10 md:mt-0 md:basis-1/2">
        {
          image && (
            <div class="relative m-auto max-w-sm">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto w-full rounded bg-gray-100 dark:bg-slate-700"
                  width={500}
                  height={500}
                  widths={[400, 768]}
                  sizes="(max-width: 768px) 100vw, 432px"
                  layout="responsive"
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</WidgetWrapper>
