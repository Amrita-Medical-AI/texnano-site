---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    class?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl bg-white">
    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter text-gray-900">
      {frontmatter.title}
    </h1>
    <div
      class={`mx-auto prose prose-base max-w-4xl dark:prose-invert prose-p:text-gray-900 dark:prose-p:text-slate-300 prose-li:text-gray-900 dark:prose-li:text-slate-300 prose-headings:text-gray-900 dark:prose-headings:text-slate-200 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 ${frontmatter.class || ''}`}
    >
      <slot />
    </div>
  </section>
</Layout>
